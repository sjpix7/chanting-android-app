    <string name="m_hare_krishna_title">Maha Mantra Hare Krishna</string>
    <string name="m_hare_krishna_meaning">El gran mantra de la liberación: una llamada sincera a Radha (Hare), Krishna y Rama para ocuparnos en el servicio devocional amoroso.</string>
    <string name="m_shiva_title">Om Namah Shivaya</string>
    <string name="m_shiva_meaning">«Me inclino ante Shiva». El mantra de cinco sílabas (Panchakshara), que honra al Ser auspicioso presente en todos.</string>
    <string name="m_gayatri_title">Mantra Gayatri</string>
    <string name="m_gayatri_meaning">Meditamos en la radiante luz divina de Savitr; que inspire e ilumine nuestro intelecto.</string>
    <string name="m_mahamrityunjaya_title">Mantra Mahamrityunjaya</string>
    <string name="m_mahamrityunjaya_meaning">Adoramos al Señor Shiva de tres ojos. Así como el pepino maduro se desprende de su tallo, que seamos liberados de la muerte y no de la inmortalidad.</string>
    <string name="m_vasudeva_title">Om Namo Bhagavate Vasudevaya</string>
    <string name="m_vasudeva_meaning">El mantra de doce sílabas: reverencias al Señor Vasudeva (Krishna), el Supremo que mora en todos los seres.</string>
    <string name="m_ram_title">Shri Ram Jai Ram</string>
    <string name="m_ram_meaning">El mantra de Rama de trece sílabas: ¡gloria al Señor Rama, refugio de los devotos!</string>
    <string name="m_radhe_title">Radhe Radhe</string>
    <string name="m_radhe_meaning">El dulce nombre de Shri Radha, encarnación del amor puro por Krishna, que resuena en todo Vrindavan.</string>
    <string name="m_ganesha_title">Mantra de Ganesha</string>
    <string name="m_ganesha_meaning">Reverencias a Ganapati, el que elimina los obstáculos; se canta antes de todo nuevo comienzo.</string>
    <string name="m_hanuman_title">Mantra de Hanuman</string>
    <string name="m_hanuman_meaning">Reverencias a Hanuman, que otorga valor, fuerza y devoción inquebrantable.</string>
    <string name="m_narayana_title">Om Namo Narayanaya</string>
    <string name="m_narayana_meaning">El mantra de ocho sílabas (Ashtakshara): reverencias a Narayana, refugio eterno de todos los seres.</string>
    <string name="m_saraswati_title">Mantra de Saraswati</string>
    <string name="m_saraswati_meaning">Reverencias a Saraswati, diosa de la sabiduría, la palabra, la música y el saber.</string>
    <string name="m_lakshmi_title">Mantra de Lakshmi</string>
    <string name="m_lakshmi_meaning">Reverencias a Mahalakshmi, diosa de la abundancia, la prosperidad y la gracia.</string>
    <string name="m_durga_title">Mantra de Durga</string>
    <string name="m_durga_meaning">Reverencias a Durga, la Madre Divina que protege a sus devotos de toda dificultad.</string>
    <string name="m_om_title">Om (Pranava)</string>
    <string name="m_om_meaning">El sonido primordial: la vibración del Absoluto de la que surge toda la creación.</string>
