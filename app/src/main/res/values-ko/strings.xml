    <string name="m_hare_krishna_title">하레 크리슈나 마하 만트라</string>
    <string name="m_hare_krishna_meaning">해탈의 위대한 만트라 — 라다(하레), 크리슈나, 라마께 사랑의 헌신으로 이끌어 주시기를 간절히 부르는 기도입니다.</string>
    <string name="m_shiva_title">옴 나마 시바야</string>
    <string name="m_shiva_meaning">“시바께 귀의합니다.” 모든 존재 안의 상서로운 참나를 공경하는 다섯 음절의 판차크샤라 만트라입니다.</string>
    <string name="m_gayatri_title">가야트리 만트라</string>
    <string name="m_gayatri_meaning">우리는 사비트리의 찬란하고 신성한 빛을 명상합니다. 그 빛이 우리의 지성을 일깨우고 밝혀 주소서.</string>
    <string name="m_mahamrityunjaya_title">마하므리튠자야 만트라</string>
    <string name="m_mahamrityunjaya_meaning">세 눈을 지닌 시바 신께 경배합니다. 잘 익은 오이가 덩굴에서 떨어지듯, 우리가 불멸이 아닌 죽음에서 벗어나게 하소서.</string>
    <string name="m_vasudeva_title">옴 나모 바가바테 바수데바야</string>
    <string name="m_vasudeva_meaning">열두 음절의 만트라: 모든 존재 안에 머무는 지고자 바수데바(크리슈나)께 귀의합니다.</string>
    <string name="m_ram_title">슈리 람 자이 람</string>
    <string name="m_ram_meaning">열세 음절의 라마 만트라: 헌신자들의 귀의처인 라마 신께 영광을.</string>
    <string name="m_radhe_title">라데 라데</string>
    <string name="m_radhe_meaning">크리슈나를 향한 순수한 사랑의 화신, 슈리 라다의 감미로운 이름으로 브린다반 곳곳에 울려 퍼집니다.</string>
    <string name="m_ganesha_title">가네샤 만트라</string>
    <string name="m_ganesha_meaning">장애를 없애 주는 가나파티께 귀의합니다. 모든 새로운 시작 전에 염송합니다.</string>
    <string name="m_hanuman_title">하누만 만트라</string>
    <string name="m_hanuman_meaning">용기와 힘, 흔들림 없는 헌신을 주는 하누만께 귀의합니다.</string>
    <string name="m_narayana_title">옴 나모 나라야나야</string>
    <string name="m_narayana_meaning">여덟 음절의 아슈탁샤라 만트라: 모든 존재의 영원한 귀의처인 나라야나께 귀의합니다.</string>
    <string name="m_saraswati_title">사라스바티 만트라</string>
    <string name="m_saraswati_meaning">지혜와 언어, 음악과 학문의 여신 사라스바티께 귀의합니다.</string>
    <string name="m_lakshmi_title">락슈미 만트라</string>
    <string name="m_lakshmi_meaning">풍요와 번영, 은총의 여신 마하락슈미께 귀의합니다.</string>
    <string name="m_durga_title">두르가 만트라</string>
    <string name="m_durga_meaning">헌신자들을 모든 어려움에서 지켜 주는 신성한 어머니 두르가께 귀의합니다.</string>
    <string name="m_om_title">옴 (프라나바)</string>
    <string name="m_om_meaning">태초의 소리 — 모든 창조가 비롯되는 절대자의 진동입니다.</string>
