    <string name="m_hare_krishna_title">Maha-mantra Hare Krishna</string>
    <string name="m_hare_krishna_meaning">Le grand mantra de la délivrance : un appel sincère à Radha (Hare), Krishna et Rama pour être engagé dans un service dévotionnel plein d\'amour.</string>
    <string name="m_shiva_title">Om Namah Shivaya</string>
    <string name="m_shiva_meaning">« Je m\'incline devant Shiva. » Le mantra à cinq syllabes (Panchakshara), qui honore le Soi bienveillant présent en chacun.</string>
    <string name="m_gayatri_title">Mantra Gayatri</string>
    <string name="m_gayatri_meaning">Nous méditons sur la lumière divine et rayonnante de Savitr ; qu\'elle inspire et illumine notre intellect.</string>
    <string name="m_mahamrityunjaya_title">Mantra Mahamrityunjaya</string>
    <string name="m_mahamrityunjaya_meaning">Nous adorons le Seigneur Shiva aux trois yeux. Comme le concombre mûr se détache de sa tige, puissions-nous être libérés de la mort, et non de l\'immortalité.</string>
    <string name="m_vasudeva_title">Om Namo Bhagavate Vasudevaya</string>
    <string name="m_vasudeva_meaning">Le mantra à douze syllabes : hommage au Seigneur Vasudeva (Krishna), le Suprême qui demeure en tous les êtres.</string>
    <string name="m_ram_title">Shri Ram Jai Ram</string>
    <string name="m_ram_meaning">Le mantra de Rama à treize syllabes : gloire au Seigneur Rama, refuge des dévots.</string>
    <string name="m_radhe_title">Radhe Radhe</string>
    <string name="m_radhe_meaning">Le doux nom de Shri Radha, incarnation de l\'amour pur pour Krishna, qui résonne dans tout Vrindavan.</string>
    <string name="m_ganesha_title">Mantra de Ganesh</string>
    <string name="m_ganesha_meaning">Hommage à Ganapati, celui qui écarte les obstacles ; on le récite avant tout nouveau commencement.</string>
    <string name="m_hanuman_title">Mantra de Hanuman</string>
    <string name="m_hanuman_meaning">Hommage à Hanuman, qui accorde le courage, la force et une dévotion inébranlable.</string>
    <string name="m_narayana_title">Om Namo Narayanaya</string>
    <string name="m_narayana_meaning">Le mantra à huit syllabes (Ashtakshara) : hommage à Narayana, refuge éternel de tous les êtres.</string>
    <string name="m_saraswati_title">Mantra de Sarasvati</string>
    <string name="m_saraswati_meaning">Hommage à Sarasvati, déesse de la sagesse, de la parole, de la musique et du savoir.</string>
    <string name="m_lakshmi_title">Mantra de Lakshmi</string>
    <string name="m_lakshmi_meaning">Hommage à Mahalakshmi, déesse de l\'abondance, de la prospérité et de la grâce.</string>
    <string name="m_durga_title">Mantra de Durga</string>
    <string name="m_durga_meaning">Hommage à Durga, la Mère divine qui protège ses dévots de toute difficulté.</string>
    <string name="m_om_title">Om (Pranava)</string>
    <string name="m_om_meaning">Le son primordial : la vibration de l\'Absolu d\'où naît toute la création.</string>
